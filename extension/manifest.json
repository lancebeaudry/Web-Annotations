{
  "manifest_version": 3,
  "name": "PinPoint Anywhere",
  "description": "Save any element on any website as a reference in one of your PinPoint projects: screenshot, styles and a note.",
  "version": "0.1.0",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "PinPoint Anywhere" },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "pick": { "suggested_key": { "default": "Alt+Shift+P" }, "description": "Pick an element on this page" }
  }
}
