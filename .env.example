# Public-safe (they ship in the bundle; RLS is the security boundary)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Where the overlay sends people to create an account / manage a project.
# GitHub Pages (supabase.co refuses to serve text/html anywhere).
DASHBOARD_URL=https://lancebeaudry.github.io/avalanche-markup-app/
# The hosted overlay bundle URL shown in the dashboard's embed snippet.
MARKUP_BUNDLE_URL=https://YOUR_PROJECT.supabase.co/storage/v1/object/public/markup/markup.js
# Shown on the Account screen.
PRO_PRICE_LABEL=$99 / year

# Server-side only — used by admin/release.mjs and admin/deploy-app.mjs to
# upload to the bucket, and by admin/new-site.mjs. NEVER ship these.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_ACCESS_TOKEN=sbp_...
