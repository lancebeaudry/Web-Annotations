{
  "name": "avalanche-markup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PinPoint by Avalanche \u2014 click-to-comment website feedback overlay",
  "scripts": {
    "build": "node build.mjs",
    "build:mock": "node build.mjs --mock",
